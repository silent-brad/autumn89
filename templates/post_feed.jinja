{% for pwi in posts %}
	<div class="post-card" id="post-card-{{pwi.post.id}}">
		<div class="post-header">
			<div class="post-meta">
				{% let name = pwi.post.walker.name %}
				{% let avatar_filename = pwi.post.walker.avatar_filename %}
				{% importnimja "partials/_walker_avatar.jinja" %}
				<small class="numbers post-date">{{pwi.post.created_at.format_date_with_ordinal()}}</small>
			</div>
			{% if session.is_some() and pwi.post.walker.id == session.get().walker_id %}
				<div class="post-actions">
					<button class="secondary outline post-action-btn" onclick="editPost({{pwi.post.id}})">Edit</button>
				</div>
			{% endif %}
		</div>
		
		<div class="post-text-content">{{pwi.post.text_content}}</div>
		
		{% if pwi.images.len > 0 %}
			<div class="post-images{% if pwi.images.len == 1 %} single-image{% endif %}">
				{% for img in pwi.images %}
					<div class="post-image" data-image-id="{{img.id}}">
						<img
							src="/pictures/{{img.filename}}"
							alt="Post image"
							loading="lazy"
						>
					</div>
				{% endfor %}
			</div>
		{% endif %}
	</div>
{% endfor %}
{% if has_more %}
	<div id="load-more-posts"
		hx-get="/api/post-feed?page={{next_page}}"
		hx-trigger="click"
		hx-target="this"
		hx-swap="outerHTML"
		hx-select="unset"
	>
		<button class="btn load-more-btn">Load More</button>
	</div>
{% endif %}
